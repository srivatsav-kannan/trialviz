# Copy to .env. Every variable is optional.

# Enables the Claude interpreter. Without it, the rule-based interpreter reads questions.
ANTHROPIC_API_KEY=

# INTERPRETER_MODEL=claude-opus-5-5
# INTERPRETER_EFFORT=low
# INTERPRETER_MAX_TOKENS=8000

# Hard cap on total Claude spending, in US dollars, persisted in LLM_LEDGER_PATH.
# LLM_SPEND_CAP_USD=20
# LLM_LEDGER_PATH=var/llm_spend.json

# ClinicalTrials.gov client.
# CTGOV_REQUESTS_PER_MINUTE=50
# CTGOV_TIMEOUT_SECONDS=30
# CTGOV_CACHE_DIR=var/cache/ctgov
# RETRIEVAL_MAX_RECORDS=10000
